DATABASE_URL=sqlite:///./weather.db
REFRESH_INTERVAL_MINUTES=30
AI_CONFIDENCE_THRESHOLD=0.65
HTTP_TIMEOUT_SECONDS=20

# Data providers: mock | cma | nmc | qweather
#   cma = rule-based per-province extreme-weather extractor (no API key needed)
WARNING_PROVIDER=cma
# Data providers: mock | openmeteo | qweather
FORECAST_PROVIDER=openmeteo
FALLBACK_TO_MOCK_ON_FAILURE=false
CMA_BULLETINS_ENABLED=true
BULLETIN_RETENTION_HOURS=72
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_BIND=127.0.0.1
WEB_PORT=5173
API_PORT=8000
# Local example only; replace before a production deployment.
POSTGRES_PASSWORD=weather

# NMC bulletin pages (comma-separated)
NMC_SOURCE_URLS=https://www.nmc.cn/publish/weatherperday/index.htm,https://www.nmc.cn/publish/country/warning/dust.html,https://www.nmc.cn/publish/weather-bulletin/index.htm

# Sources shared with cma_publish; mid-range is displayed as outlook only.
CMA_SOURCE_URLS=https://www.nmc.cn/publish/weather-bulletin/index.htm,https://www.nmc.cn/publish/weatherperday/index.htm,https://www.nmc.cn/publish/typhoon/warning_index.html,https://www.nmc.cn/publish/bulletin/mid-range.htm,https://www.nmc.cn/publish/news/weather_new.html

# QWeather
QWEATHER_API_BASE=https://devapi.qweather.com/v7
QWEATHER_API_KEY=

# Open-Meteo
OPENMETEO_API_BASE=https://api.open-meteo.com/v1

# AI: none | openai
AI_PROVIDER=none
AI_ENABLED_FOR_NMC=true
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

DEFAULT_LAT=39.9042
DEFAULT_LON=116.4074
DEFAULT_PROVINCE=北京
DEFAULT_LABEL=北京
