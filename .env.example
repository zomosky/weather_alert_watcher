DATABASE_URL=sqlite:///./weather.db
REFRESH_INTERVAL_MINUTES=30
AI_CONFIDENCE_THRESHOLD=0.65
HTTP_TIMEOUT_SECONDS=20

# Data providers: mock | cma | nmc | qweather
#   cma = explicit NMC publication statements and region-specific forecast windows
WARNING_PROVIDER=cma
# Data providers: mock | openmeteo | qweather
FORECAST_PROVIDER=openmeteo
FALLBACK_TO_MOCK_ON_FAILURE=false
CMA_BULLETINS_ENABLED=true
BULLETIN_RETENTION_HOURS=72
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_BIND=127.0.0.1
WEB_PORT=5173
API_PORT=8000
# Local example only; replace before a production deployment.
POSTGRES_PASSWORD=weather

# NMC bulletin pages (comma-separated)
NMC_SOURCE_URLS=https://www.nmc.cn/publish/weatherperday/index.htm,https://www.nmc.cn/publish/country/warning/dust.html,https://www.nmc.cn/publish/weather-bulletin/index.htm

# Base bulletin sources shared with cma_publish; national warning sources are added separately.
CMA_SOURCE_URLS=https://www.nmc.cn/publish/weather-bulletin/index.htm,https://www.nmc.cn/publish/weatherperday/index.htm,https://www.nmc.cn/publish/typhoon/warning_index.html,https://www.nmc.cn/publish/bulletin/mid-range.htm,https://www.nmc.cn/publish/news/weather_new.html

# Official navigation-verified warning/risk products. Empty value disables these additions.
CMA_WARNING_SOURCE_URLS=https://www.nmc.cn/publish/country/warning/wind.html,https://www.nmc.cn/publish/country/warning/strong_convection.html,https://www.nmc.cn/publish/country/warning/downpour.html,https://www.nmc.cn/publish/country/warning/typhoon.html,https://www.nmc.cn/publish/country/warning/megatemperature.html,https://www.nmc.cn/publish/country/warning/fog.html,https://www.nmc.cn/publish/country/warning/dust.html,https://www.nmc.cn/publish/country/warning/blizzard.html,https://www.nmc.cn/publish/country/warning/cold.html,https://www.nmc.cn/publish/country/warning/frozen.html,https://www.nmc.cn/publish/country/warning/drought.html,https://www.nmc.cn/publish/country/warning/low-temperature.html,https://www.nmc.cn/publish/mountainflood.html,https://www.nmc.cn/publish/geohazard.html,https://www.nmc.cn/publish/waterlogging.html,https://www.nmc.cn/publish/swdz/zxhlhsqxyj.html,https://www.nmc.cn/publish/bulletin/swpc.html,https://www.nmc.cn/publish/environment/forestfire-doc.html
# Public website index, separate from national warning map; all pages are checked.
CMA_LOCAL_SIGNALS_ENABLED=true
CMA_LOCAL_SOURCE_URL=https://www.nmc.cn/rest/findAlarm
CMA_LOCAL_MAX_PAGES=30

# QWeather
QWEATHER_API_BASE=https://devapi.qweather.com/v7
QWEATHER_API_KEY=

# Open-Meteo
OPENMETEO_API_BASE=https://api.open-meteo.com/v1

# AI: none | openai
AI_PROVIDER=none
AI_ENABLED_FOR_NMC=true
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

DEFAULT_LAT=39.9042
DEFAULT_LON=116.4074
DEFAULT_PROVINCE=北京
DEFAULT_LABEL=北京
